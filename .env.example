# Gemini API Key for Continue Extension
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Additional environment variables for kernel development
KERNEL_VERSION=6.1
ARCH=arm64
CROSS_COMPILE=aarch64-linux-gnu-
CC=clang-12
HOSTCC=clang-12
LLVM=1
