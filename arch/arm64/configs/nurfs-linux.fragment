# NURFS: Native Unified RootFS - Linux-compat supplement
# Makes the kernel understand Linux natively alongside Android (no chroot/container)
# KIO-FUSE native (for AnyRealm Matrix arbitrary EXE - real NT env via VFS, not Wine)
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_DAX=y
# EUD (Embedded USB Debugger) - keep hardware interface alive for Matrix module telemetry
# Only KALLSYMS=y (not _ALL) to avoid host kallsyms tool buffer crash on autoksyms.h:1369
CONFIG_QCOM_EUD=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# Disable autoksyms dynamic trim - eliminates include/generated/autoksyms.h generation that crashes host kallsyms
CONFIG_AUTOKSYMS=n
# Systemd + Debian image builder (DIB) hard requirements
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y
CONFIG_IPC_NS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS4_FS=y
CONFIG_ANON_VMA_NAME=y
# Compressed read-only roots for NURFS live layers
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
# Optional but useful for flexible NURFS partitions
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
