#
# Motorola Genevn (Parrot) - android12-5.10 Kernel Configuration
# Applicable to: userdebug, eng, user builds
#

# --- Core Architecture & CPU ---
CONFIG_ARCH_PARROT=y
CONFIG_ARCH_QCOM=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_PARAVIRT=y
CONFIG_COMPAT=y
CONFIG_SCHED_MC=y
CONFIG_NR_CPUS=32
CONFIG_RCU_FAST_NO_HZ=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_CPUSETS=y
CONFIG_RT_SOFTINT_OPTIMIZATION=y
# CONFIG_ARM64_AMU_EXTN is not set
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem"
CONFIG_CMDLINE_EXTEND=y
CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# --- CPU Frequency & Idle ---
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_IDLE_GOV_QCOM_LPM=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG=y
CONFIG_ARM_CPUIDLE=y
CONFIG_ARM_PSCI_CPUFREQ=y
CONFIG_ARM_SCPI_CPUFREQ=y
CONFIG_ARM_SCMI_CPUFREQ=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_PANIC_ON_OOPS is not set

# --- Qualcomm SCMI Protocols ---
CONFIG_QTI_SCMI_PMU_PROTOCOL=y
CONFIG_QTI_SCMI_PLH_PROTOCOL=y
CONFIG_QTI_SCMI_CPUFREQ_STATS_PROTOCOL=y
CONFIG_QTI_SCMI_SHARED_RAIL_PROTOCOL=y
CONFIG_ARM_SCMI_PROTOCOL=y
